{
  "name": "@taiyomoe/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./sql/*": "./src/generated/prisma/sql/*",
    "./browser": "./src/generated/prisma/browser.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "typecheck": "tsc --noEmit",
    "seed": "prisma migrate reset && pnpm -F @taiyomoe/logs run migrate",
    "db": "prisma",
    "migrate": "tsx ./src/migrations-handler.ts",
    "postinstall": "prisma generate",
    "data-migration:add_normalized_email": "tsx ./src/prisma/migrations/20250312161343_add_normalized_email/data-migration.ts",
    "data-migration:add_usernames": "tsx ./src/prisma/migrations/20250312171952_add_usernames/data-migration.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "@t3-oss/env-core": "^0.13.8",
    "@taiyomoe/utils": "workspace:^",
    "prisma-json-types-generator": "^3.6.2",
    "prisma-zod-generator": "^1.31.3",
    "validator": "^13.15.20",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@taiyomoe/typescript": "workspace:^",
    "@types/validator": "^13.15.4",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
