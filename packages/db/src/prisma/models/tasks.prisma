model Task {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type    TaskType
  status  TaskStatus
  payload Json

  sessionId String @db.Uuid
}

// ----- ENUMS
enum TaskType {
  CREATE_MEDIA
  IMPORT_MEDIA
  IMPORT_COVER
  IMPORT_CHAPTER
  UPLOAD_CHAPTER
  UPLOAD_COVER
  UPLOAD_BANNER
}

enum TaskStatus {
  PENDING
  DOWNLOADING
  UPLOADING
  FINISHED
  FAILED
}
