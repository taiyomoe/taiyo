meta {
  name: Update banner
  type: http
  seq: 3
}

patch {
  url: {{url}}/medias/:id/banners/:bannerId
  body: json
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
  bannerId: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "contentRating": "SUGGESTIVE"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
