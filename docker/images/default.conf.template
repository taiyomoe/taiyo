server {
  listen 80;
  resolver 127.0.0.11 valid=30s ipv6=off;

  if ($request_method !~ ^(GET|HEAD)$) {
    return 405;
  }

  location ~ ^/(?<bucket>[^/]+)/(?<key>.+)$ {
    proxy_pass http://rustfs:9000/$bucket/$key;
    proxy_intercept_errors on;
    error_page 403 404 = @production;
  }

  location @production {
    proxy_pass ${IMAGES_FALLBACK_URL}/$key;
    proxy_ssl_server_name on;
  }
}
