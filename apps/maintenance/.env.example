# `pnpm bootstrap` creates this file and keeps the dev server port in sync with
# the root .env. The VITE_ values are baked into the static build, so set them
# in the hosting provider's build settings too.

# Dev server
PORT="3004"

# Countdown
# When Taiyō is expected back, as an ISO 8601 date with an offset. The countdown
# is hidden when unset.
VITE_MAINTENANCE_ENDS_AT="2026-11-20T06:00:00Z"

# Contact
# Discord invite in the header; the link is hidden when unset.
# VITE_DISCORD_INVITE_URL="https://discord.gg/<invite>"
