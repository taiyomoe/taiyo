# `pnpm bootstrap` creates this file and keeps the ports and URLs in sync with
# the root .env.

# Dev server
PORT="3000"
API_PORT="3002"
IMAGES_PORT="54902"
RUSTFS_PORT="54900"
S3_BUCKET_NAME="taiyo"

# Auth
VITE_BETTER_AUTH_URL="http://localhost:3002"
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Contact
VITE_SUPPORT_EMAIL="support@taiyo.moe"
# Discord invite in the landing footer; the link is hidden when unset.
# VITE_DISCORD_INVITE_URL="https://discord.gg/<invite>"

# API
VITE_API_URL="http://localhost:3002"

# Umami (audience measurement), with the `umami` compose profile. Bootstrap fills the
# internal URL; the website id comes from the site you add in Umami's UI. Unset, the
# tracker is left out of the pages.
UMAMI_INTERNAL_URL=""
# VITE_UMAMI_WEBSITE_ID="<website id>"
