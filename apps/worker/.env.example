# `pnpm bootstrap` creates this file and keeps every URL and credential that
# points at local infrastructure in sync with the root .env.

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:54320/taiyo"

# Dragonfly
DRAGONFLY_URL="redis://localhost:54379"

# S3
S3_ENDPOINT="http://localhost:54900"
S3_ACCESS_KEY_ID="taiyo"
S3_SECRET_ACCESS_KEY="root-password"
S3_BUCKET_NAME="taiyo"
S3_PUBLIC_URL="http://localhost:54900/taiyo"

# Worker
# Max chapters processed in parallel by the worker. Tune to the box's CPU.
CHAPTER_PROCESSING_CONCURRENCY=4
