    "@t3-oss/env-core": "^0.13.11",
    "@taiyomoe/audit": "workspace:^",
    "@taiyomoe/auth": "workspace:^",
    "@taiyomoe/cache": "workspace:^",
    "@taiyomoe/config": "workspace:^",
    "@taiyomoe/db": "workspace:^",
    "@taiyomoe/emails": "workspace:^",
    "@taiyomoe/mangadex": "workspace:^",
    "@taiyomoe/permissions": "workspace:^",
    "@taiyomoe/queue": "workspace:^",
    "@taiyomoe/s3": "workspace:^",
    "@taiyomoe/schemas": "workspace:^",
    "@taiyomoe/search": "workspace:^",
    "evlog": "^2.35.1",
    "hono": "^4.13.18",
    "hono-openapi": "^1.6.0",
    "hono-rate-limiter": "^0.5.4",
    "magic-bytes.js": "^1.13.1",
    "remeda": "^2.61.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "fflate": "^0.8.3",
    "kysely": "^0.29.9",
    "pg": "^8.23.1"
