# Node environment, either "development" or "production"
NODE_ENV="development"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taiyo"

# Dragonfly
DRAGONFLY_URL="redis://localhost:6379"

# HyperDX
HYPERDX_INGESTION_KEY=""
HYPERDX_ENDPOINT="http://localhost:4318"

# S3
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="taiyo"
S3_SECRET_ACCESS_KEY="root-password"
S3_BUCKET_NAME="taiyo"

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# Auth
BETTER_AUTH_SECRET="" # Generate with `npx auth secret`
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
VITE_BETTER_AUTH_URL="http://localhost:3002"
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# CORS — comma-separated origins allowed to call the API with credentials
# (empty / unset = same-origin only)
CORS_ALLOWED_ORIGINS=""

# Email
RESEND_API_KEY=""
