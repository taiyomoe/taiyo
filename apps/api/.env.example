# Node environment, either "development" or "production"
NODE_ENV="development"

# `pnpm bootstrap` creates this file and keeps every URL, port and credential
# that points at local infrastructure in sync with the root .env. Edit those
# there, not here. Everything else is yours to change.

# Dev server
PORT="3002"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:54320/taiyo"

# Dragonfly
DRAGONFLY_URL="redis://localhost:54379"

# HyperDX
# Optional outside production, and only running locally with the `hyperdx`
# compose profile (COMPOSE_PROFILES in the root .env); bootstrap leaves the
# endpoint empty otherwise. The local collector only accepts logs once the
# HyperDX UI has a team: sign up at http://localhost:<HYPERDX_PORT>, then paste
# the ingestion key from Team Settings here. Empty keeps logs on stdout only.
HYPERDX_INGESTION_KEY=""
HYPERDX_ENDPOINT="http://localhost:54318"

# S3
S3_ENDPOINT="http://localhost:54900"
S3_ACCESS_KEY_ID="taiyo"
S3_SECRET_ACCESS_KEY="root-password"
S3_BUCKET_NAME="taiyo"
# Public base URL images are served from (CDN in production, the RustFS
# endpoint + bucket locally). No trailing slash.
S3_PUBLIC_URL="http://localhost:54900/taiyo"

# Meilisearch
MEILISEARCH_HOST="http://localhost:54700"
MEILISEARCH_API_KEY="local-master-key"

# Auth
# Replace with your own for anything but local dev: `npx auth secret`
BETTER_AUTH_SECRET="local-dev-secret-not-actually-secret"
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
VITE_BETTER_AUTH_URL="http://localhost:3002"
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# CORS — comma-separated origins allowed to call the API with credentials
# (empty / unset = same-origin only)
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Email
# Any non-empty key lets the app boot; outbound mail only works with a real one
RESEND_API_KEY="re_dummy"
