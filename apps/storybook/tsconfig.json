{
  "extends": "@taiyomoe/typescript/base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noUncheckedSideEffectImports": false,
    "paths": {
      "@/storybook/*": ["./.storybook/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [".storybook/**/*", "./src/**/*"],
  "exclude": ["node_modules"]
}
