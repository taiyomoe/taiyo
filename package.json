{
  "name": "taiyo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "bootstrap": "node tooling/dev/src/bootstrap.ts",
    "dev": "turbo run dev --filter='!@taiyomoe/storybook'",
    "dev:tunnel": "node tooling/dev/src/tunnel.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint:ws": "sherif",
    "postinstall": "pnpm -F @taiyomoe/web compile:messages; lefthook install",
    "knip": "knip",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:unit:watch": "vitest --config vitest.config.unit.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:integration:watch": "vitest --config vitest.config.integration.ts"
  },
  "devDependencies": {
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2003",
    "sherif": "^1.13.0",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
