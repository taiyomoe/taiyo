{
  "name": "taiyo",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "bootstrap": "node tooling/scripts/src/bootstrap.ts",
    "dev": "turbo run dev --filter='!@taiyomoe/storybook' --filter='!@taiyomoe/maintenance'",
    "dev:tunnel": "node tooling/scripts/src/tunnel.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint:ws": "sherif",
    "lint:messages": "node tooling/scripts/src/check-messages.ts",
    "postinstall": "pnpm -F @taiyomoe/web -F @taiyomoe/maintenance compile:messages; lefthook install",
    "knip": "knip",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:unit:watch": "vitest --config vitest.config.unit.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:integration:watch": "vitest --config vitest.config.integration.ts",
    "test:e2e": "pnpm -F @taiyomoe/web test:e2e"
  },
  "devDependencies": {
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@stylistic/eslint-plugin": "^6.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.2.1",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "sherif": "^1.13.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.21.0"
}
