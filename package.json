{
  "name": "taiyo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter='!@taiyomoe/storybook'",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws && lefthook install",
    "knip": "knip",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:unit:watch": "vitest --config vitest.config.unit.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:integration:watch": "vitest --config vitest.config.integration.ts"
  },
  "devDependencies": {
    "@stylexjs/eslint-plugin": "^0.19.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tailwindcss": "^1.9.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
