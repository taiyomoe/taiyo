# Node environment, either "development" or "production"
NODE_ENV="development"

# Database
DATABASE_USERNAME="postgres"
DATABASE_PASSWORD="postgres"
DATABASE_NAME="taiyo"
DATABASE_PORT="5432"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taiyo"

# Dragonfly
DRAGONFLY_PORT="6379"
DRAGONFLY_URL="redis://localhost:6379"

# HyperDX
HYPERDX_PORT="8080"
HYPERDX_OTLP_PORT="4318"
HYPERDX_INGESTION_KEY=""
HYPERDX_ENDPOINT="http://localhost:4318"

# RustFS
RUSTFS_ACCESS_KEY="taiyo"
RUSTFS_SECRET_KEY="root-password"
RUSTFS_PORT="9000"
RUSTFS_CONSOLE_PORT="9001"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="taiyo"
S3_SECRET_ACCESS_KEY="root-password"
S3_BUCKET_NAME="taiyo"

# Meilisearch
MEILISEARCH_PORT="7700"
MEILISEARCH_MASTER_KEY=""
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# Auth
BETTER_AUTH_URL="http://localhost:3002"
BETTER_AUTH_SECRET="" # Generate with `npx auth secret`
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TURNSTILE_SECRET_KEY=""

# Email
RESEND_API_KEY=""

# API
# Comma-separated list of browser origins allowed to call the API with credentials.
# Leave empty to disable CORS entirely (same-origin only).
CORS_ALLOWED_ORIGINS=""
