# Local ports and credentials
#
# `pnpm bootstrap` creates this file and treats it as the source of truth: it
# derives every connection URL in apps/*/.env from the values here. Edit a port
# or a credential, rerun `pnpm bootstrap`, and the app env files follow.
#
# Ports are published on 127.0.0.1 only. Each checkout (a git worktree, say)
# claims a slot, and slot N shifts every port below by 10 * N, so checkouts
# never collide. This template is slot 0; bootstrap picks the first free slot.

# Dev servers
WEB_PORT="3000"
API_PORT="3002"

# Postgres
DATABASE_USERNAME="postgres"
DATABASE_PASSWORD="postgres"
DATABASE_NAME="taiyo"
DATABASE_PORT="54320"

# Dragonfly
DRAGONFLY_PORT="54379"

# HyperDX
# Off by default: it is what production uses for logs, but locally it is a heavy
# stack (ClickHouse + MongoDB) most work does not need. Uncomment to run it, then
# rerun `pnpm bootstrap`.
# COMPOSE_PROFILES="hyperdx"
HYPERDX_PORT="54800"
HYPERDX_OTLP_PORT="54318"

# Meilisearch
MEILISEARCH_PORT="54700"
MEILISEARCH_MASTER_KEY="local-master-key"

# RustFS
RUSTFS_ACCESS_KEY="taiyo"
RUSTFS_SECRET_KEY="root-password"
RUSTFS_PORT="54900"
RUSTFS_CONSOLE_PORT="54901"

# Images (read-only): serves the local bucket, and falls back to the production
# CDN for keys it does not have, so the seeded sample shows real images while
# uploads stay local.
IMAGES_PORT="54902"
IMAGES_FALLBACK_URL="https://cdn.taiyo.moe"
