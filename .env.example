# Docker Compose infrastructure
#
# These variables are consumed by docker-compose.yml for container ports and
# credentials. App-level connection strings (DATABASE_URL, S3_*, MEILISEARCH_*,
# etc.) live in the per-app env files — see apps/api/.env.example and
# apps/web/.env.example.

# Postgres
DATABASE_USERNAME="postgres"
DATABASE_PASSWORD="postgres"
DATABASE_NAME="taiyo"
DATABASE_PORT="5432"

# Dragonfly
DRAGONFLY_PORT="6379"

# HyperDX
HYPERDX_PORT="8080"
HYPERDX_OTLP_PORT="4318"

# Meilisearch
MEILISEARCH_PORT="7700"
MEILISEARCH_MASTER_KEY=""

# RustFS
RUSTFS_ACCESS_KEY="taiyo"
RUSTFS_SECRET_KEY="root-password"
RUSTFS_PORT="9000"
RUSTFS_CONSOLE_PORT="9001"
