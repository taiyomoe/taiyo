# Docker Compose infrastructure
#
# These variables are consumed by docker-compose.yml for container ports and
# credentials. App-level connection strings (DATABASE_URL, S3_*, MEILISEARCH_*,
# etc.) live in the per-app env files — see apps/api/.env.example and
# apps/web/.env.example.
#
# Ports are published on 127.0.0.1 only, and deliberately sit outside each
# service's default so a local Postgres/Redis/etc. does not collide. If you run
# a second checkout (a git worktree, say) at the same time, shift every port
# here and the matching URLs in apps/api/.env — container names are already
# namespaced by directory, so only the host ports clash.

# Postgres
DATABASE_USERNAME="postgres"
DATABASE_PASSWORD="postgres"
DATABASE_NAME="taiyo"
DATABASE_PORT="54320"

# Dragonfly
DRAGONFLY_PORT="54379"

# HyperDX
HYPERDX_PORT="54800"
HYPERDX_OTLP_PORT="54318"

# Meilisearch
# Must match MEILISEARCH_API_KEY in apps/api/.env
MEILISEARCH_PORT="54700"
MEILISEARCH_MASTER_KEY="local-master-key"

# RustFS
# Must match S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY in apps/api/.env
RUSTFS_ACCESS_KEY="taiyo"
RUSTFS_SECRET_KEY="root-password"
RUSTFS_PORT="54900"
RUSTFS_CONSOLE_PORT="54901"
